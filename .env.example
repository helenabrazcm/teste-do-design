# ============================================================================
# FAIR NUZZI - CONFIGURAÇÕES DE AMBIENTE
# ============================================================================
# IMPORTANTE: Copie este arquivo para .env e preencha com seus valores
# NUNCA versione o arquivo .env no GitHub!
# ============================================================================

# SEGURANÇA: Chave secreta para sessões Flask
# Gere uma chave aleatória forte. Exemplo:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Esta chave DEVE ser mantida em segredo e não pode mudar entre execuções
# Se mudar, todas as sessões ativas serão invalidadas
FEIRA_SECRET=coloque-uma-chave-aleatoria-super-segura-aqui-min-64-caracteres

# ============================================================================
# CREDENCIAIS DE TESTE - SÓ PARA DESENVOLVIMENTO
# ============================================================================
# Use senhas diferentes e fortes em produção!
# Estas credenciais SÃ usadas apenas se o banco estiver vazio (first run)

# Cliente demo
DEMO_CLIENTE_EMAIL=cliente@feiranuzzi.com
DEMO_CLIENTE_PASS=compras123

# Vendedor demo
DEMO_VENDEDOR_EMAIL=nino@feiranuzzi.com
DEMO_VENDEDOR_PASS=colheita2024

# Admin demo
DEMO_ADMIN_EMAIL=admin@feiranuzzi.com
DEMO_ADMIN_PASS=admin123

# ============================================================================
# FLASK - Configurações da aplicação
# ============================================================================
# FLASK_ENV=development  # ou 'production'
# FLASK_DEBUG=False       # NUNCA ativar em produção

# ============================================================================
# BANCO DE DADOS
# ============================================================================
# DATABASE_URL=sqlite:///./feira.db  (opcional, usa padrão local)

# ============================================================================
# CORS - Origens permitidas para requisições cross-origin
# ============================================================================
# Por padrão, o app detecta automaticamente o IP local
# Para ambiente específico, você pode adicionar:
# CORS_ORIGINS=http://localhost:5000,http://192.168.1.100:5000

# ============================================================================
# LOGGING
# ============================================================================
# LOG_LEVEL=INFO  (ou DEBUG para mais detalhes)

# ============================================================================
# NÃO ADICIONE INFORMAÇÕES SENSÍVEIS ABAIXO
# ============================================================================
